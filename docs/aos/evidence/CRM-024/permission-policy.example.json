{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushBetaRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:UploadLayerPart",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:CompleteLayerUpload",
        "ecr:BatchGetImage",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:eu-west-1:000000000000:repository/aos-crm-beta"
    },
    {
      "Sid": "EcsRegisterTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "EcsRunMigrateTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:eu-west-1:000000000000:task-definition/aos-crm-beta-*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:eu-west-1:000000000000:cluster/aos-crm-beta"
        }
      }
    },
    {
      "Sid": "EcsUpdateBetaServices",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:eu-west-1:000000000000:service/aos-crm-beta/aos-crm-beta-*"
    },
    {
      "Sid": "EcsTagBetaResources",
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": [
        "arn:aws:ecs:eu-west-1:000000000000:task-definition/aos-crm-beta-*",
        "arn:aws:ecs:eu-west-1:000000000000:service/aos-crm-beta/aos-crm-beta-*",
        "arn:aws:ecs:eu-west-1:000000000000:cluster/aos-crm-beta"
      ]
    },
    {
      "Sid": "PassBetaTaskRolesToEcsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::000000000000:role/aos-crm-beta-ecs-task-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EcrReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "ecr:List*",
        "ecr:Get*",
        "ecr:Describe*"
      ],
      "Resource": "arn:aws:ecr:eu-west-1:000000000000:repository/aos-crm-beta"
    },
    {
      "Sid": "EcsReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "ecs:List*",
        "ecs:Describe*"
      ],
      "Resource": [
        "arn:aws:ecs:eu-west-1:000000000000:task-definition/aos-crm-beta-*",
        "arn:aws:ecs:eu-west-1:000000000000:service/aos-crm-beta/aos-crm-beta-*",
        "arn:aws:ecs:eu-west-1:000000000000:cluster/aos-crm-beta"
      ]
    },
    {
      "Sid": "EcsReadWithNoResourceLevelPermission",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeServices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamReadBetaRolesForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "iam:List*",
        "iam:Get*"
      ],
      "Resource": "arn:aws:iam::000000000000:role/aos-crm-beta-*"
    },
    {
      "Sid": "IamReadBetaSesUserForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "iam:List*",
        "iam:Get*"
      ],
      "Resource": "arn:aws:iam::000000000000:user/aos-crm-beta-*"
    },
    {
      "Sid": "RdsReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "rds:List*",
        "rds:Describe*"
      ],
      "Resource": [
        "arn:aws:rds:eu-west-1:000000000000:subgrp:aos-crm-beta",
        "arn:aws:rds:eu-west-1:000000000000:db:aos-crm-beta"
      ]
    },
    {
      "Sid": "ElastiCacheReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "elasticache:List*",
        "elasticache:Describe*"
      ],
      "Resource": [
        "arn:aws:elasticache:eu-west-1:000000000000:subnetgroup:aos-crm-beta",
        "arn:aws:elasticache:eu-west-1:000000000000:replicationgroup:aos-crm-beta",
        "arn:aws:elasticache:eu-west-1:000000000000:parametergroup:aos-crm-beta"
      ]
    },
    {
      "Sid": "ElastiCacheReadWithNoResourceLevelPermission",
      "Effect": "Allow",
      "Action": "elasticache:DescribeCacheClusters",
      "Resource": "*"
    },
    {
      "Sid": "S3ReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "s3:List*",
        "s3:Get*"
      ],
      "Resource": [
        "arn:aws:s3:::aos-crm-beta-logic-function-layers-000000000000",
        "arn:aws:s3:::aos-crm-beta-files-000000000000"
      ]
    },
    {
      "Sid": "SecretsManagerReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:List*",
        "secretsmanager:Get*",
        "secretsmanager:Describe*"
      ],
      "Resource": "arn:aws:secretsmanager:eu-west-1:000000000000:secret:aos-crm/beta/*"
    },
    {
      "Sid": "LogsReadForPlanRefresh",
      "Effect": "Allow",
      "Action": "logs:List*",
      "Resource": "arn:aws:logs:eu-west-1:000000000000:log-group:/ecs/aos-crm-beta/*"
    },
    {
      "Sid": "LogsReadWithNoResourceLevelPermission",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "BudgetsReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "budgets:View*",
        "budgets:List*"
      ],
      "Resource": "arn:aws:budgets::000000000000:budget/aos-crm-beta-monthly"
    },
    {
      "Sid": "NoResourceLevelPermissionReadForPlanRefresh",
      "Effect": "Allow",
      "Action": [
        "sesv2:List*",
        "sesv2:Get*",
        "route53:List*",
        "route53:Get*",
        "elasticloadbalancing:Describe*",
        "ec2:Describe*",
        "acm:List*",
        "acm:Get*",
        "acm:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::example-state-bucket/aos-crm/beta/*"
    },
    {
      "Sid": "TerraformStateBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::example-state-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": "aos-crm/beta/*"
        }
      }
    },
    {
      "Sid": "TerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:000000000000:table/aos-crm-tfstate-lock"
    }
  ]
}
