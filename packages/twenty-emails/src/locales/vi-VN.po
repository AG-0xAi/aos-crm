msgstr "Chào mừng bạn đến với Betty!"

#. js-lingui-explicit-id
#: src/emails/send-invite-link.email.tsx
msgid "You're receiving this email because you were invited to join a workspace on Betty."
msgstr "Bạn nhận được email này vì bạn được mời tham gia một không gian làm việc trên Betty."

#. js-lingui-explicit-id
#: src/emails/sign-up-invite-link.email.tsx
