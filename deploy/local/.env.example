# Template for deploy/local/.env (gitignored, real values never committed).
#
# This is NOT the app's privacy/feature-flag contract: that is
# deploy/local/privacy.env (CRM-003, consumed via env_file in compose.yaml).
# This file only holds the values docker compose itself needs to
# interpolate deploy/local/compose.yaml: the build tag and the handful of
# secrets/ports the server/db containers are given through `environment:`.
#
# scripts/aos/local.ps1 generates deploy/local/.env for you with
# cryptographically random values and a verified-free loopback port; it
# never prints them. Fill this template by hand only if you are not using
# that script, and never with these example placeholders.

# Local, non-moving build reference. compose.yaml's `build:` always builds this
# image from packages/twenty-docker/twenty/Dockerfile (target: twenty) using
# the pinned twenty/v2.51.0 source (15e4826d3b5fc5867baeabeeb42b253892b2d4da)
# in this checkout; nothing here pulls twentycrm/twenty from a registry.
#
# The reference names the upstream pin AND the AOS commit the bytes were built
# from (`-aos<12 hex>`). The pin alone is not enough: every AOS commit on top
# of it builds a different image, so a pin-only reference gets overwritten with
# different bytes and `docker image inspect` ends up describing an artifact
# nobody is running (CRM-004-fix2). local.ps1 derives this value from git HEAD
# and docs/aos/bootstrap/provenance.json, and re-derives it immediately before
# every build; the value below is a placeholder shape, not a usable name.
AOS_CRM_IMAGE_TAG=aos-crm-local/twenty:v2.51.0-15e4826d3b-aos0123456789ab
AOS_CRM_APP_VERSION=twenty-v2.51.0+15e4826d3b

# Loopback-only web port for the compiled frontend + API. Verify it is free
# on 127.0.0.1 before using it (local.ps1 does this automatically).
AOS_CRM_WEB_PORT=43000
AOS_CRM_SERVER_URL=http://127.0.0.1:43000

# PostgreSQL: container-network only, never published to the host (SEC-02).
AOS_CRM_PG_USER=aos_crm
AOS_CRM_PG_DB=aos_crm_local
# openssl rand -hex 32   (or let local.ps1 generate it)
AOS_CRM_PG_PASSWORD=replace_me_with_a_random_hex_string

# App encryption key (replaces the legacy APP_SECRET for instances created
# after Twenty introduced ENCRYPTION_KEY). openssl rand -base64 32, or let
# local.ps1 generate it.
AOS_CRM_ENCRYPTION_KEY=replace_me_with_a_random_base64_string
