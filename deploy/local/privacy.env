# AOS-CRM privacy profile (CRM-003). A NON-SECRET, versioned contract of
# Twenty feature flags for the server AND worker (both consume this same
# file via compose.yaml's env_file -- see CRM-002). Real credentials never
# belong here: those live in deploy/local/.env, which IS gitignored (this
# file deliberately is not -- see docs/aos/bootstrap/TELEMETRY_AUDIT.md).
#
# Checked by scripts/aos/verify-privacy.mjs and required by
# scripts/aos/local.ps1 before Start/Restart. Every key below is a real
# flag read by packages/twenty-server/src/engine/core-modules/twenty-config/
# config-variables.ts at the pinned twenty/v2.51.0 source -- see
# docs/aos/bootstrap/TELEMETRY_AUDIT.md for the file/line evidence behind
# each one. Do not add a DSN, API key or token to this file: it is
# versioned and reviewed like any other source file, not a secret store.

# Self-hosting usage ping to https://twenty-telemetry.com. Upstream default
# is true; TelemetryService.publish() returns early (no HTTP client is ever
# created) when this is false.
TELEMETRY_ENABLED=false

# Local analytics backend flag exposed to the client as clientConfig.analyticsEnabled.
# Upstream default is already false; pinned here so an upstream default
# flip is not silently inherited.
ANALYTICS_ENABLED=false

# Stops the npm-registry marketplace catalog cron from ever being
# registered on server boot (CronRegisterAllCommand skips it when this
# is false). Upstream default is true.
MARKETPLACE_CATALOG_SYNC_CRON_ENABLED=false

# Env-only switch read directly from process.env before Nest wires up the
# app module graph: when false, TwentyConfigModule never imports
# DatabaseConfigModule at all, so TwentyConfigService's @Optional()
# databaseConfigDriver is undefined and every config read falls through to
# the environment driver -- a value a previous session persisted to the DB
# (core.configVariable) cannot silently reactivate telemetry/analytics/
# marketplace sync because the code path that would read it is never wired
# in. Upstream default is true. See TELEMETRY_AUDIT.md for the exact
# module/service evidence.
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false

# Env-only. Upstream already defaults to CONSOLE (no remote Sentry), pinned
# here explicitly so this profile does not depend on that default
# surviving an upstream change. instrument.ts only calls Sentry.init() when
# this equals SENTRY.
EXCEPTION_HANDLER_DRIVER=CONSOLE

# compose.yaml's environment: block already forces these two for the
# Docker path (env_file values lose to environment: for the same key), but
# this file is meant to be a complete, portable privacy contract on its
# own -- e.g. for a native (non-Docker) run in CRM-004/005 that does not go
# through compose.yaml's environment: override.
LOGIC_FUNCTION_TYPE=DISABLED
CODE_INTERPRETER_TYPE=DISABLED
