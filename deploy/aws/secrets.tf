# Every value ECS injects as PG_DATABASE_URL / REDIS_URL / ENCRYPTION_KEY
# comes from Secrets Manager via the task definition's `secrets` block
# (valueFrom a secret ARN), never from the task definition's plaintext
# `environment` block -- that block is readable by anyone who can call
# DescribeTaskDefinition, which would defeat storing a password here at
# all. No value in this file is a literal: each is generated by `random_*`
# at apply time, so there is no static credential to rotate by hand nor to
# leak from this public fork.

resource "random_password" "db" {
  length  = 40
  special = false # avoids URL-encoding the password inside PG_DATABASE_URL
}

resource "random_password" "redis_auth" {
  length  = 40
  special = false # ElastiCache AUTH tokens reject '/', '"' and '@'
}

resource "random_password" "encryption_key" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "pg_database_url" {
  name        = "aos-crm/${var.environment}/pg-database-url"
  description = "Full PG_DATABASE_URL for the aos-crm ${var.environment} server/worker/migrate tasks."

  tags = {
    Name = "aos-crm-${var.environment}-pg-database-url"
  }
}

resource "aws_secretsmanager_secret_version" "pg_database_url" {
  secret_id     = aws_secretsmanager_secret.pg_database_url.id
  secret_string = "postgres://${aws_db_instance.this.username}:${random_password.db.result}@${aws_db_instance.this.address}:${aws_db_instance.this.port}/${aws_db_instance.this.db_name}"
}

resource "aws_secretsmanager_secret" "redis_url" {
  name        = "aos-crm/${var.environment}/redis-url"
  description = "Full REDIS_URL (rediss://, AUTH token included) for the aos-crm ${var.environment} server/worker tasks."

  tags = {
    Name = "aos-crm-${var.environment}-redis-url"
  }
}

resource "aws_secretsmanager_secret_version" "redis_url" {
  secret_id     = aws_secretsmanager_secret.redis_url.id
  secret_string = "rediss://:${random_password.redis_auth.result}@${aws_elasticache_replication_group.this.primary_endpoint_address}:6379"
}

resource "aws_secretsmanager_secret" "encryption_key" {
  name        = "aos-crm/${var.environment}/encryption-key"
  description = "ENCRYPTION_KEY for the aos-crm ${var.environment} server/worker/migrate tasks (deploy/local/compose.yaml parity)."

  tags = {
    Name = "aos-crm-${var.environment}-encryption-key"
  }
}

resource "aws_secretsmanager_secret_version" "encryption_key" {
  secret_id     = aws_secretsmanager_secret.encryption_key.id
  secret_string = random_password.encryption_key.result
}

# CRM-036: only created when var.signup_webhook_url is set -- empty means
# the webhook stays off (ecs.tf's SignupWebhookService never enqueues), and
# an empty-string secret value here would be a live, readable placeholder
# for nothing. Unlike the three secrets above, this one's value is not
# generated by Terraform: it is the founder's own webhook URL
# (variables.tf), which only he can hand to the operator.
resource "aws_secretsmanager_secret" "signup_webhook_url" {
  count       = var.signup_webhook_url != "" ? 1 : 0
  name        = "aos-crm/${var.environment}/signup-webhook-url"
  description = "SIGNUP_WEBHOOK_URL for the aos-crm ${var.environment} server/worker tasks (CRM-034's lead funnel)."

  tags = {
    Name = "aos-crm-${var.environment}-signup-webhook-url"
  }
}

resource "aws_secretsmanager_secret_version" "signup_webhook_url" {
  count         = var.signup_webhook_url != "" ? 1 : 0
  secret_id     = aws_secretsmanager_secret.signup_webhook_url[0].id
  secret_string = var.signup_webhook_url
}
