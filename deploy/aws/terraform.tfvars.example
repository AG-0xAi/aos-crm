# Copy to terraform.tfvars (gitignored, see .gitignore in this directory)
# and fill in the two REPLACE_ME values before `terraform plan`/`apply`.
# Region, budget and environment below are the beta's real settings (founder
# decision, 29/10/2026); the domain and the alert address are placeholders,
# because a real domain or email in this public fork identifies the business.

environment        = "beta"
aws_region         = "eu-west-1"        # founder decision (Ireland)
budget_amount_usd  = 500                # founder decision: alarm, not a cap
domain_name        = "REPLACE_ME"       # apex of the beta namespace, e.g. yourdomain.tld
budget_alert_email = "REPLACE_ME"       # who AWS Budgets notifies

# Hosted zone for domain_name is looked up by name (data.tf). Uncomment only
# to override that lookup -- see variables.tf.
# route53_zone_id = "REPLACE_ME"

# Apex and www stay on the ALB while these are unset, which is what the beta
# runs today: the CRM answers at api./app./<workspace>. only (CRM-018).
# Uncomment and fill with the values the landing host publishes to move the
# apex and www off this stack. Nothing else changes; rolling back is removing
# these two lines and applying again (BETA_RUNBOOK.md).
# apex_a_records   = ["REPLACE_ME"]  # A record the landing host publishes
# www_cname_target = "REPLACE_ME"    # CNAME target for www.<domain>

# Outbound mail, in the three stages BETA_RUNBOOK.md §8 describes. Both false
# (the default, so these two lines can stay commented) is what the beta runs
# today: every invitation and password reset goes to the server log and the
# operator passes it on by hand.
#   Stage 2, once AWS takes SES out of the sandbox: outbound_email_enabled.
#   Stage 3, once every existing user has a verified address in the database:
#   email_verification_required. It is refused without stage 2, because the
#   verification link would have nowhere to go but the log.
# outbound_email_enabled      = true
# email_verification_required = true

# External mailbox at the apex (a provider like the one the founder uses, not
# SES: SES only sends). The MX and SPF values come from the provider's own
# setup page; the CNAME map carries its DKIM keys and, if it publishes them,
# autodiscover/autoconfig. Keys are names relative to <domain>, so Terraform
# appends the domain itself. Every value below is a generic example.
# apex_mailbox_mx_records = ["5 mx1.example.net", "10 mx2.example.net"]
# apex_mailbox_spf_value  = "v=spf1 include:_spf.example.net ~all"
# apex_mailbox_cname_records = {
#   "providerkey-a._domainkey" = "providerkey-a.dkim.example.net"
#   "providerkey-b._domainkey" = "providerkey-b.dkim.example.net"
#   "autodiscover"             = "autodiscover.example.net"
# }

server_cpu           = 512
server_memory        = 1024
worker_cpu           = 512
worker_memory        = 1024
server_desired_count = 1
worker_desired_count = 1

db_instance_class       = "db.t4g.micro"
db_allocated_storage_gb = 20

redis_node_type = "cache.t4g.micro"

# Digest of the image already pushed to the ECR repository this stack
# creates (chicken-and-egg: push after the first apply, then set this and
# apply again, or push to a pre-created repository -- see
# AWS_DEPLOYMENT_PLAN.md's deploy sequence). This is a placeholder, not a
# real digest.
image_digest = "sha256:deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
