# Copy to terraform.tfvars (gitignored, see .gitignore in this directory)
# and fill in the two REPLACE_ME values before `terraform plan`/`apply`.
# Region, budget and environment below are the beta's real settings (founder
# decision, 29/10/2026); the domain and the alert address are placeholders,
# because a real domain or email in this public fork identifies the business.

environment        = "beta"
aws_region         = "eu-west-1"        # founder decision (Ireland)
budget_amount_usd  = 500                # founder decision: alarm, not a cap
domain_name        = "REPLACE_ME"       # apex of the beta namespace, e.g. yourdomain.tld
budget_alert_email = "REPLACE_ME"       # who AWS Budgets notifies

# Hosted zone for domain_name is looked up by name (data.tf). Uncomment only
# to override that lookup -- see variables.tf.
# route53_zone_id = "REPLACE_ME"

server_cpu           = 512
server_memory        = 1024
worker_cpu           = 512
worker_memory        = 1024
server_desired_count = 1
worker_desired_count = 1

db_instance_class       = "db.t4g.micro"
db_allocated_storage_gb = 20

redis_node_type = "cache.t4g.micro"

# Digest of the image already pushed to the ECR repository this stack
# creates (chicken-and-egg: push after the first apply, then set this and
# apply again, or push to a pre-created repository -- see
# AWS_DEPLOYMENT_PLAN.md's deploy sequence). This is a placeholder, not a
# real digest.
image_digest = "sha256:deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
